# Data files (personal portfolio state - gitignored for privacy)
# Uncomment these lines if you don't want to track your portfolio
# data/*.json
# data/journal/
# data/research/

# Always ignore these folders
data/opinions/
data/journal/entries/
data/scan-results/

# API keys (never commit!)
config/api-keys.json

# Keep sample/starter files
!data/.gitkeep
!data/portfolio.json
!data/positions.json
!data/trades.json
!data/watchlist.json

# Cache
*.pyc
__pycache__/
.cache/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Logs
*.log
